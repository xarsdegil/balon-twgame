# Unity project lives in /balon.
# Keep these source folders tracked:
#   /balon/Assets
#   /balon/Packages/manifest.json
#   /balon/Packages/packages-lock.json
#   /balon/ProjectSettings
# Unity .meta files inside tracked source folders must also be committed.

# -----------------------------------------------------------------------------
# Local project notes and assistant working files
# -----------------------------------------------------------------------------
/Assistant/

# -----------------------------------------------------------------------------
# Unity generated caches and local editor state
# -----------------------------------------------------------------------------
/balon/[Ll]ibrary/
/balon/[Tt]emp/
/balon/[Oo]bj/
/balon/[Ll]ogs/
/balon/[Uu]ser[Ss]ettings/
/balon/[Mm]emoryCaptures/
/balon/[Rr]ecordings/
/balon/.utmp/
/balon/ExportedObj/

# This package is declared in manifest.json and restored by Unity Package
# Manager. The expanded local copy contains generated/downloaded tooling.
/balon/Packages/com.unity.ai.assistant/

# -----------------------------------------------------------------------------
# Generated IDE and solution files
# -----------------------------------------------------------------------------
/.vs/
/.vscode/
/.idea/
/balon/.vs/
/balon/.vscode/
/balon/.idea/
/balon/.consulo/

/balon/*.csproj
/balon/*.sln
/balon/*.slnx
/balon/*.unityproj
/balon/*.booproj
/balon/*.pidb
/balon/*.svd
/balon/*.pdb
/balon/*.mdb
/balon/*.opendb
/balon/*.VC.db
/balon/*.csproj.DotSettings.user

*.suo
*.user
*.userprefs

# Generated debug symbol metadata
*.pidb.meta
*.pdb.meta
*.mdb.meta

# -----------------------------------------------------------------------------
# Builds and exported packages
# -----------------------------------------------------------------------------
/balon/[Bb]uild/
/balon/[Bb]uilds/
*.apk
*.aab
*.app
*.exe
*.x86
*.x86_64
*.so
*.dSYM/
*.symbols.zip
*.unitypackage
*.unitypackage.meta

# Addressables and Asset Store generated content
/balon/[Aa]ssets/[Ss]treamingAssets/aa/
/balon/[Aa]ssets/[Ss]treamingAssets/aa.meta
/balon/[Aa]ssets/AssetStoreTools*
/balon/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# -----------------------------------------------------------------------------
# Platform and tool caches
# -----------------------------------------------------------------------------
/.gradle/
/balon/.gradle/
/balon/[Aa]ssets/[Pp]lugins/[Aa]ndroid/.gradle/
/balon/[Aa]ssets/Plugins/Editor/JetBrains*
crashlytics-build.properties

# -----------------------------------------------------------------------------
# Logs, temporary files, secrets, and operating-system noise
# -----------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.orig
*.swp
*.swo

.env
.env.*
!.env.example

.DS_Store
Thumbs.db
Desktop.ini
sysinfo.txt
